# Caddy：站点地址由 .env 里的 SITE_ADDRESS 决定，改完 docker compose up -d 即可
#   有域名   → SITE_ADDRESS=yorozuya.example.com   （自动申请并续期 Let's Encrypt 证书）
#   只用 IP  → SITE_ADDRESS=:80                    （先跑通，没有 HTTPS）
# 前提：有域名时，A 记录要指向这台服务器，且 80/443 都放行（ACME 校验要用 80）

{$SITE_ADDRESS} {
	encode zstd gzip

	# ★ 这里原本有一层全站 Basic Auth 门禁（2026-09-17 加过，同日按用户要求撤掉）。
	#   撤掉的原因：**这个站点只做展示** —— 注册关闭、只开访客模式
	#   （免注册进入、一个字节都不写库、工作台对访客一律拒绝），所以不必再把整站锁起来。
	#   ⚠️ 哪天要把它当"真能用"的站点（开放注册 / 允许登录用户用工作台），
	#      必须把这层门禁加回来 —— 工作台是能在服务器上**真执行命令**的。
	#   加回来的写法（注意指令名随版本变：v2.4~v2.7 是 basicauth，v2.8+ 改成 basic_auth）：
	#     basicauth {
	#       用户名 <bcrypt哈希>     # docker exec deploy-caddy-1 caddy hash-password --plaintext '密码'
	#     }

	# 反代到 compose 内网的 app 容器（uvicorn :8902）
	reverse_proxy app:8902

	# 附件上传默认上限 8MB（见 yorozuya/files.py），给点余量
	request_body {
		max_size 12MB
	}

	header {
		# 单机自用应用：别被搜索引擎收录
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
