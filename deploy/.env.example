# Copy this file to deploy/.env on the server, then replace every value.
# Never commit deploy/.env: it contains production credentials.

# A domain name (for example: yorozuya.example.com) or :80 for HTTP-only testing.
SITE_ADDRESS=yorozuya.example.com

# The public origin allowed to call the API. Keep the scheme and do not add a trailing slash.
PUBLIC_URL=https://yorozuya.example.com

# Generate long, unique values before deploying.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-app-password
